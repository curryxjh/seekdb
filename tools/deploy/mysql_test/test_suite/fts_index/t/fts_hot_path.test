select tokenize('Hello HELLO hello world WORLD database DATABASE audit the a', 'beng', '[{"output":"all"}]') as tokens;
select tokenize('Hello HELLO hello world WORLD', 'space', '[{"output":"all"}]') as tokens;
select tokenize('!!! ...ABC??? __42-- C++ foo-bar foo_bar foo@bar.com 123.45', 'beng', '[{"output":"all"}]') as tokens;
select tokenize('ÉCOLE Straße İSTANBUL CAFÉ 中文 ＡＢＣ １２３ 😀', 'beng', '[{"output":"all"}]') as tokens;
select tokenize('😀 𠀀', 'beng', '[{"output":"all"}]') as tokens;
select tokenize('𠀀 😀', 'beng', '[{"output":"all"}]') as tokens;
select tokenize('A BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB z CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC end END', 'beng', '[{"output":"all"}]') as tokens;
select tokenize('aaa AAA bbbb BBBB ccccc The THE', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":4},{"max_token_size":10}]}]') as tokens;

create table docs(id int primary key, cn text, en text, plain text);
insert into docs values
  (1, '数据库 全文索引 分词器 数据库', 'Database database performance audit', 'Hello hello HELLO'),
  (2, '数据库优化 分词器 OceanBase', 'AUDIT performance security', 'hello world'),
  (3, '中华人民共和国 一百二十三个 全文索引', 'database reliability', 'database audit'),
  (4, 'ＡＢＣ １２３ 中文 😀', 'C++ foo-bar ÉCOLE', ''),
  (5, '', '', NULL), (6, NULL, NULL, 'audit audit');
alter table docs add fulltext index ft_cn(cn) with parser ik;
alter table docs add fulltext index ft_en(en) with parser beng;
alter table docs add fulltext index ft_plain(plain) with parser space;
select id, round(match(cn) against('数据库 全文索引'), 6) as score from docs where match(cn) against('数据库 全文索引') order by id;
select id, round(match(en) against('database performance audit'), 6) as score from docs where match(en) against('database performance audit') order by id;
select id from docs where match(en) against('+database -audit' in boolean mode) order by id;
select id from docs where match(cn) against('不存在的词') order by id;
select id from docs where match(plain) against('hello') order by id;
select id from docs where match(cn) against('全文索引') order by id limit 1;
select id from docs where match(en) against('database performance audit') > 1.0 order by id;
select id from docs where match(en) against('database performance audit') = 0 order by id;
select id from docs where match(en) against('database performance audit') and id <> 1 order by id;
select id from docs where match(en) against('database performance audit') order by id limit 1 offset 1;
select tokenize('ABC abc 四月 中文', 'ngram', '[{"output":"all"},{"additional_args":[{"ngram_token_size":2}]}]') as tokens;
select tokenize('ABC abc 四月 中文', 'ngram2', '[{"output":"all"},{"additional_args":[{"min_ngram_size":1},{"max_ngram_size":2}]}]') as tokens;
insert into docs values (7, '全文索引 全文索引 数据库', 'database AUDIT audit', 'HELLO audit');
update docs set cn = '音乐欣赏', en = 'music only', plain = 'music' where id = 1;
delete from docs where id = 2;
select id, round(match(cn) against('数据库 全文索引'), 6) as score from docs where match(cn) against('数据库 全文索引') order by id;
select id, round(match(en) against('database audit'), 6) as score from docs where match(en) against('database audit') order by id;
begin;
update docs set en = 'audit', cn = '全文索引' where id = 1;
rollback;
select id from docs where match(en) against('audit') order by id;
alter table docs drop index ft_cn;
alter table docs add fulltext index ft_cn(cn) with parser ik parser_properties=(ik_mode='max_word');
select id from docs where match(cn) against('全文索引 数据库') order by id;
drop database fts_hot_path_regression;
