# owner group: storage
# Preserve tokenizer output, frequencies, relevance, and index maintenance
# across the IK character dispatch / BENG buffer / word grouping optimizations.
--disable_warnings
drop database if exists fts_hot_path_regression;
--enable_warnings
create database fts_hot_path_regression;
use fts_hot_path_regression;
set names utf8mb4;
set ob_query_timeout = 100000000;

select tokenize('', 'ik') as tokens;
select tokenize(NULL, 'beng') as tokens;
select tokenize('全文索引 分词器 OceanBase 数据库优化', 'ik', '[{"output":"all"}]') as tokens;
select tokenize('中华人民共和国 一百二十三个 2026年10月 3.14kg A-B C++ mail@example.com', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') as tokens;
select tokenize('中华人民共和国 一百二十三个 2026年10月 3.14kg A-B C++ mail@example.com', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') as tokens;
select tokenize('ＡＢＣ ａｂｃ １２３ 中文 あいう カタカナ 한글 😀 𠀀', 'ik', '[{"output":"all"}]') as tokens;
select tokenize(concat('数据库 ', char(9 using utf8mb4), ' 全文索引 ', char(10 using utf8mb4), ' 数据库'), 'ik', '[{"output":"all"}]') as tokens;
