select tokenize('Hello HELLO hello world WORLD database DATABASE audit the a', 'beng', '[{"output":"all"}]') as tokens;
tokens
{"tokens": [{"audit": 1}, {"world": 2}, {"database": 2}, {"hello": 3}], "doc_len": 8}
select tokenize('Hello HELLO hello world WORLD', 'space', '[{"output":"all"}]') as tokens;
tokens
{"tokens": [{"world": 2}, {"hello": 3}], "doc_len": 5}
select tokenize('!!! ...ABC??? __42-- C++ foo-bar foo_bar foo@bar.com 123.45', 'beng', '[{"output":"all"}]') as tokens;
tokens
{"tokens": [{"123": 1}, {"bar": 3}, {"abc": 1}, {"foo": 3}], "doc_len": 8}
select tokenize('ÉCOLE Straße İSTANBUL CAFÉ 中文 ＡＢＣ １２３ 😀', 'beng', '[{"output":"all"}]') as tokens;
tokens
{"tokens": [{"café": 1}, {"straße": 1}, {"école": 1}, {"😀": 1}, {"１２３": 1}, {"中文": 1}, {"ａｂｃ": 1}, {"istanbul": 1}], "doc_len": 8}
