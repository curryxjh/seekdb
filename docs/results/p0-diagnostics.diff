@@ -0,0 +1,39 @@
+#pragma once
+
+#ifdef MVDB_DIAGNOSTICS
+#include <chrono>
+#include <cstdint>
+
+namespace mvdb::diagnostics {
+struct Stats {
+  uint64_t pwrite_calls = 0, pwrite_bytes = 0, pwrite_ns = 0;
+  uint64_t pread_calls = 0, pread_bytes = 0, pread_ns = 0;
+  uint64_t fsync_calls = 0, fsync_ns = 0;
+  uint64_t blob_calls = 0, blob_bytes = 0, blob_reads = 0, blob_read_bytes = 0, blob_ns = 0;
+  uint64_t publish_calls = 0, publish_ns = 0;
+  uint64_t checksum_calls = 0, checksum_bytes = 0, checksum_ns = 0, checksum_io_ns = 0;
+  uint64_t node_calls = 0, node_cache_hits = 0, node_cache_misses = 0, node_entries_copied = 0;
+  uint64_t scan_calls = 0, scan_nodes = 0, scan_entries = 0, scan_ns = 0;
+  uint64_t find_calls = 0, put_calls = 0, put_ns = 0;
+  uint64_t select_calls = 0, cache_builds = 0, filter_hits = 0, filter_builds = 0;
+  uint64_t eligible_rows = 0, code_rows = 0, seed_updates = 0;
+  uint64_t int8_checks = 0, int8_rejects = 0, float_checks = 0, float_rejects = 0;
+  uint64_t refinements = 0, top_updates = 0, first_select_ns = 0;
+  uint64_t select_ns = 0, bind_ns = 0, cache_ns = 0, filter_ns = 0, code_ns = 0;
+  uint64_t seed_ns = 0, refine_ns = 0;
+  uint64_t filtered_queries = 0, unfiltered_queries = 0;
+  uint64_t filtered_ns = 0, unfiltered_ns = 0;
+  uint64_t json_ns = 0, sql_ns = 0, execute_ns = 0, output_ns = 0;
+  uint64_t request_count = 0, sql_count = 0, inserted_rows = 0;
+  uint64_t commit_calls = 0, commit_ns = 0, catalog_copy_ns = 0;
+  uint64_t publish_checksum_ns = 0, publish_fsync_ns = 0, publish_pwrite_ns = 0;
+  uint64_t convert_ns = 0, vector_conversions = 0;
+};
+
+inline Stats stats;
+using Clock = std::chrono::steady_clock;
+inline uint64_t elapsed(Clock::time_point start) {
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count());
+}
+}
+#endif
